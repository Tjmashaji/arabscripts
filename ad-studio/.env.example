# ───── قاعدة البيانات (ثلاثة أدوار، انظر DATABASE_SCHEMA.md) ─────
# تطبيق الويب: يخضع لسياسات RLS
DATABASE_URL=postgres://studio_app:CHANGE_ME@127.0.0.1:5432/ad_studio
# العامل الخلفي: يتجاوز RLS ويقيّد استعلاماته بمعرّف المهمة
WORKER_DATABASE_URL=postgres://studio_worker:CHANGE_ME@127.0.0.1:5432/ad_studio
# الترحيلات وبذر قوالب النظام فقط
MIGRATION_DATABASE_URL=postgres://studio_owner:CHANGE_ME@127.0.0.1:5432/ad_studio

# ───── التطبيق ─────
APP_URL=http://localhost:3000
# 32 حرفًا عشوائيًا على الأقل: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_SIGNING_SECRET=
STORAGE_DIR=./storage
MAX_UPLOAD_MB=200
SIGNUP_LIMIT_PER_HOUR=10
LOGIN_LIMIT_PER_15MIN=30
# وضع المحاكاة: مسموح افتراضيًا خارج الإنتاج فقط. اجعله false في الإنتاج الحقيقي.
# ALLOW_SIMULATION=false
# مهلة الاحتفاظ بالملفات المحذوفة قبل حذفها نهائيًا (npm run cleanup)
RETENTION_DAYS=30

# ───── مزودو الذكاء الاصطناعي (اتركها فارغة لتعمل المحاكاة أو تظهر الخدمة غير متصلة) ─────
# المخرج الإبداعي وتحليل الصور
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# التعليق الصوتي (بدون المفتاح يُستخدم الصوت المجاني FREE_TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# صوت مجاني بلا مفتاح (أصوات Microsoft عبر edge-tts، خدمة غير رسمية). يتطلب python3 وedge-tts
FREE_TTS=true
# سعر 1000 حرف بالسنت حسب خطتك (يُستخدم لحساب التكلفة التقديرية)
ELEVENLABS_CENTS_PER_1K_CHARS=30
# توليد الفيديو
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4.5
RUNWAY_MODEL_TEXT=gen4.5
# قيمة الرصيد الواحد بالسنت، وتقدير الاستهلاك في الثانية لفحص سقف الإنفاق قبل الإرسال
RUNWAY_CENTS_PER_CREDIT=1
RUNWAY_EST_CREDITS_PER_SECOND=12
