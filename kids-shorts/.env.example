# ───── التطبيق ─────
APP_URL=http://localhost:3000
# مجلد قاعدة البيانات (SQLite) والملفات المصدَّرة
DATA_DIR=./data
# مفتاح تشفير رموز يوتيوب: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
SIGNUP_LIMIT_PER_HOUR=10
LOGIN_LIMIT_PER_15MIN=30
MAX_AUDIO_MB=15

# ───── يوتيوب (Google Cloud Console → OAuth client: Web application) ─────
# رابط العودة المطلوب إضافته في Google: APP_URL/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───── اختياري: المخرج الذكي للمواضيع المخصصة ─────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ───── اختياري: الصوت الذكي ─────
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# معرّف صوت عربي من مكتبة أصواتك في ElevenLabs
ELEVENLABS_VOICE_ID=
