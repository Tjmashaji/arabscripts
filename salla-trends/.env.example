# ── قاعدة البيانات (PostgreSQL 14+) ──
# trends_app: صفحات التاجر والإدارة، يخضع لسياسات RLS
DATABASE_URL=postgres://trends_app:trends_app_dev@127.0.0.1:5432/salla_trends
# trends_worker: الويب هوك والمزامنة وحساب الترند
WORKER_DATABASE_URL=postgres://trends_worker:trends_worker_dev@127.0.0.1:5432/salla_trends
# trends_owner: للترحيلات وإنشاء المسؤولين فقط (لا يحتاجه التطبيق نفسه)
MIGRATION_DATABASE_URL=postgres://trends_owner:trends_owner_dev@127.0.0.1:5432/salla_trends

# العنوان العام للموقع: منه يُبنى رابط الرجوع من سلة وروابط الشارة
APP_URL=http://localhost:3000

# مفتاح تشفير رموز سلة: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── تطبيق سلة (من بوابة الشركاء: portal.salla.partners) ──
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
# سر الويب هوك (Webhook Secret) من صفحة التطبيق في البوابة
SALLA_WEBHOOK_SECRET=
# رابط تثبيت التطبيق من متجر تطبيقات سلة (اختياري، يظهر زرًا في الصفحة الرئيسية)
SALLA_INSTALL_URL=

# يحمي /api/cron/* (Vercel Cron يرسله تلقائيًا): openssl rand -hex 24
CRON_SECRET=

# ── عتبات الخصوصية والترند (القيم الافتراضية مناسبة للبداية) ──
# TRENDS_MIN_STORES=3
# TRENDS_MAX_STORE_SHARE=0.7
# TRENDS_MIN_UNITS=10
# BACKFILL_DAYS=90

# معاينة محلية بلا سلة: npm run db:demo ثم افتح /api/dev/login (يعمل في next dev فقط)
# DEV_LOGIN=true
